VITE_TGA_TOKEN=your-telegram-analytics-token-here
VITE_TGA_APP_NAME=your-app-name
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Voice chat (optional) ───────────────────────────────────────────────
# The LiveKit server address. Public by nature — the browser must know where
# to connect. Leave it unset and the voice UI does not render at all.
#
# The API KEY and SECRET are deliberately NOT here. Anything with a VITE_
# prefix is compiled into the JavaScript bundle and readable by every player,
# so a secret placed here would be published. They belong in Supabase secrets,
# where only the livekit-token Edge Function can read them:
#
#   supabase secrets set LIVEKIT_API_KEY=...
#   supabase secrets set LIVEKIT_API_SECRET=...
#
# See supabase/functions/livekit-token/README.md
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
