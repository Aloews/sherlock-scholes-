VITE_TGA_TOKEN=your-telegram-analytics-token-here
VITE_TGA_APP_NAME=your-app-name
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Voice chat (optional) ───────────────────────────────────────────────
# Three services are supported: livekit (default), daily, agora.
# Full setup, per provider: docs/VOICE_PROVIDERS.md
#   node scripts/check-voice.mjs --vars   ← what is needed, what is already set
#
# NOTHING VITE_-PREFIXED IS A SECRET. Vite compiles these values into the
# JavaScript bundle, where every player can read them. Keys and certificates
# live in Supabase secrets, where only the token Edge Function sees them:
#
#   supabase secrets set VOICE_PROVIDER=livekit VOICE_PROVIDER_FALLBACK=agora
#   supabase secrets set LIVEKIT_API_KEY=... LIVEKIT_API_SECRET=...
#   supabase secrets set DAILY_API_KEY=...   DAILY_DOMAIN=yourteam.daily.co
#   supabase secrets set AGORA_APP_ID=...    AGORA_APP_CERTIFICATE=...
#
# The server's VOICE_PROVIDER and this VITE_VOICE_PROVIDER must agree — the
# server signs for its own, and a mismatch yields a token that is valid and
# unusable. `npm run check:voice` fails on it before a player finds out.
VITE_VOICE_PROVIDER=livekit

# Optional second service, tried when the first will not come up (blocked,
# unroutable, down). Its adapter is bundled too — that is what makes failover
# possible — so set it only if you mean to use it. Must match the server's
# VOICE_PROVIDER_FALLBACK, and that service needs its own secrets set.
# Failover is for UNREACHABLE services, not slow ones: see docs/VOICE_PROVIDERS.md §6.
# VITE_VOICE_FALLBACK=agora

# livekit only — the server address. Public by nature: the browser has to know
# where to connect. Leave every voice variable unset and the voice UI does not
# render at all, and the SDK is not even built into the bundle.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# daily / agora only — neither needs a public address (Daily's room URL and
# Agora's app id travel with the token), so this is what turns the UI on.
# VITE_VOICE_ENABLED=true
