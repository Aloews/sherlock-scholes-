VITE_TGA_TOKEN=your-telegram-analytics-token-here
VITE_TGA_APP_NAME=your-app-name
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Voice chat (optional) ───────────────────────────────────────────────
# Three services are supported: livekit (default), daily, agora.
# Full setup, per provider: docs/VOICE_PROVIDERS.md
#   node scripts/check-voice.mjs --vars   ← what is needed, what is already set
#
# NOTHING VITE_-PREFIXED IS A SECRET. Vite compiles these values into the
# JavaScript bundle, where every player can read them. Keys and certificates
# live in Supabase secrets, where only the token Edge Function sees them:
#
#   supabase secrets set VOICE_PROVIDER=livekit
#   supabase secrets set LIVEKIT_API_KEY=... LIVEKIT_API_SECRET=...
#   supabase secrets set DAILY_API_KEY=...   DAILY_DOMAIN=yourteam.daily.co
#   supabase secrets set AGORA_APP_ID=...    AGORA_APP_CERTIFICATE=...
#
# Which service to start with. The server signs for whichever one the client
# names, provided it holds the keys, so this no longer has to match the
# server's VOICE_PROVIDER — that is now only the default for callers that name
# nothing. `npm run check:voice` reports what the deployment can serve.
VITE_VOICE_PROVIDER=livekit

# Carry all three adapters so a dead service can be walked past at runtime.
# Costs bundle size — three SDK chunks in dist/ instead of one — but they are
# dynamic imports, so the second is fetched only after the first has failed.
# Unset means one adapter and no failover, which is the older behaviour.
# VITE_VOICE_FALLBACK=true

# livekit only — the server address. Public by nature: the browser has to know
# where to connect. Leave every voice variable unset and the voice UI does not
# render at all, and the SDK is not even built into the bundle.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# daily / agora only — neither needs a public address (Daily's room URL and
# Agora's app id travel with the token), so this is what turns the UI on.
# VITE_VOICE_ENABLED=true

# ─── Live TV (optional, unrelated to gameplay — see docs/ADR/0004) ───────
# m3u/HLS playlist URL served by the standalone stream-service relay. Public
# by nature, same reasoning as VITE_LIVEKIT_URL above. Unset: the /stream
# screen renders a "not configured" state instead of a player.
# VITE_STREAM_URL=https://your-stream-service.example.com/playlist.m3u8

# Rights-holder complaint mailbox. Rendered as a "Report to the rights
# holder" mailto link under the player. Unset: no report link is shown.
# VITE_STREAM_ABUSE_CONTACT=abuse@your-domain.example

# Takedown lever: set to "true" and redeploy to pull the home-screen entry
# on a verified rights-holder complaint, without touching code. The /stream
# route stays reachable directly — same treatment as /admin.
# VITE_STREAM_HIDDEN=true
