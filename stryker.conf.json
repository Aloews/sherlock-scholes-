{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing on the game logic core. Kept tightly scoped so the run stays fast; grow `mutate` as the harness spreads outward.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/features/game/stateMachine.ts",
    "src/shared/lib/tier.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
