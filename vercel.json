{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "routes": [
        {
          "src": "/assets/(.*)",
          "dest": "/assets/$1"
        },
        {
          "src": "/logo-(.*)",
          "dest": "/logo-$1"
        },
        {
          "src": "/(.*)",
          "dest": "/index.html"
        }
      ],
      "ignoreCommand": "node scripts/vercel-ignore-build.mjs"
    },
    "football_dynasty": {
      "root": "services/football-dynasty",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "football_dynasty"
      }
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "service": "football_dynasty"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
