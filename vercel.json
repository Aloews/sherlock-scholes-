{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "routes": [
        {
          "src": "/assets/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/assets/$1"
            }
          ]
        },
        {
          "src": "/logo-(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/logo-$1"
            }
          ]
        },
        {
          "src": "/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/index.html"
            }
          ]
        }
      ]
    },
    "football_dynasty": {
      "root": "services/football-dynasty",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "football_dynasty"
      }
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "service": "football_dynasty"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/logo-(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
