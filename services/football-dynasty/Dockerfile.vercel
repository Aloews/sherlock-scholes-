FROM rust:1.90-bookworm AS builder
WORKDIR /app/football-dynasty
COPY football-dynasty/Cargo.toml ./Cargo.toml
COPY football-dynasty/src ./src
COPY football-dynasty/migrations ./migrations
COPY sherlock-core /app/sherlock-core
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home app
COPY --from=builder /app/football-dynasty/target/release/football-dynasty /usr/local/bin/football-dynasty
USER 10001:10001
ENV PORT=80
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/football-dynasty"]
